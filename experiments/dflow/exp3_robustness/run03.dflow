eservices
    EServiceHTTP get_coords_svc
        verb: GET
        host: 'https://services.issel.ee.auth.gr'
        path: '/geospatial/get_coords'
    end

    EServiceHTTP get_charging_stations_svc
        verb: GET
        host: 'https://services.issel.ee.auth.gr'
        path: '/openstreetmaps/get_charging_stations'
    end

    EServiceHTTP get_taxi_stations_svc
        verb: GET
        host: 'https://services.issel.ee.auth.gr'
        path: '/openstreetmaps/get_taxi_stations'
    end

    EServiceHTTP get_batteries_recycling_points_svc
        verb: GET
        host: 'https://services.issel.ee.auth.gr'
        path: '/openstreetmaps/get_batteries_recycling_points'
    end

    EServiceHTTP get_public_toilets_svc
        verb: GET
        host: 'https://services.issel.ee.auth.gr'
        path: '/openstreetmaps/get_public_toilets'
    end
end

triggers
    Intent get_coords
        "What are the coordinates of" PE:GPE,
        "I need the latitude and longitude of" PE:GPE,
        "Can you find the coordinates for" PE:GPE
    end

    Intent charging_stations
        "Show me nearby charging stations",
        "Find electric vehicle charging stations",
        "Where can I charge my EV?"
    end

    Intent general_info
        "Tell me about the city",
        "General information based on location",
        "What can you tell me about this area?"
    end
end

dialogues
    Dialogue GetCoordinatesDialogue
        on: get_coords
        responses:
            Form coords_form
                city: str = HRI('Which city are you interested in?', [PE:GPE])
            end,
            ActionGroup coords_action
                get_coords_svc(query=[city=coords_form.city], header=[Authorization='Q5eJZ8sSLEX6XNmOHyMlWagI'],)[lat]
                get_coords_svc(query=[city=coords_form.city], header=[Authorization='Q5eJZ8sSLEX6XNmOHyMlWagI'],)[lon]
                Speak('The coordinates of ' coords_form.city ' are: latitude ' lat ', longitude ' lon '.')
            end
    end

    Dialogue ChargingStationsDialogue
        on: charging_stations
        responses:
            Form charging_stations_form
                latitude: float = HRI('Enter latitude:')
                longitude: float = HRI('Enter longitude:')
                radius: float = HRI('Enter search radius:')
            end,
            ActionGroup charging_action
                Speak('This feature is available only to paid users.')[roles=user_free]
                get_charging_stations_svc(query=[latitude=charging_stations_form.latitude, longitude=charging_stations_form.longitude, radius=charging_stations_form.radius], header=[Authorization='Q5eJZ8sSLEX6XNmOHyMlWagI'],)[results.tags]
                Speak('Polis Park - operated by fortizo at latitude ' latitude ', longitude ' longitude '.')[roles=user_paid]
            end
    end

    Dialogue GeneralInfoDialogue
        on: general_info
        responses:
            Form general_info_form
                latitude: float = HRI('Enter latitude:')
                longitude: float = HRI('Enter longitude:')
                radius: float = HRI('Enter search radius:')
            end,
            ActionGroup info_action
                get_taxi_stations_svc(query=[latitude=general_info_form.latitude, longitude=general_info_form.longitude, radius=general_info_form.radius], header=[Authorization='Q5eJZ8sSLEX6XNmOHyMlWagI'],)[tags]
                Speak('Taxi stand at Πλ. Συντάγματος - latitude ' latitude ', longitude ' longitude '.')[roles=user_paid]
                get_batteries_recycling_points_svc(query=[latitude=general_info_form.latitude, longitude=general_info_form.longitude, radius=general_info_form.radius], header=[Authorization='Q5eJZ8sSLEX6XNmOHyMlWagI'],)[tags]
                Speak('Battery recycling bin - Ανακύκλωση μπαταριών.')[roles=user_paid]
                Speak('Battery recycling bin - Ανακύκλωση μπαταριών.')[roles=user_free]
                get_public_toilets_svc(query=[latitude=general_info_form.latitude, longitude=general_info_form.longitude, radius=general_info_form.radius], header=[Authorization='Q5eJZ8sSLEX6XNmOHyMlWagI'],)[tags]
                Speak('Public toilet - free of charge, not wheelchair accessible - latitude ' latitude ', longitude ' longitude '.')[roles=user_paid]
                Speak('Additional information is available through a paid plan.')[roles=user_free]
            end
    end
end

access_controls
    Roles
        user_paid,
        user_free

        default: 
            user_free
    end

    Path
        "/home/Desktop/users.txt"
    end

    Authentication
        method: slack        
    end
end

