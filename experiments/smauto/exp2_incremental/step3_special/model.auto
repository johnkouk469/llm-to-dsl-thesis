Metadata
    name: ExpandedSmartHomeAutomation
    version: "2.1.0"
    description: "Expanded automation with realistic sensor data simulation for temperature and humidity control in smart home environments."
    author: "Your Name"
    email: "yourname@example.com"
end

RTMonitor
    broker: monitor_redis_broker
    namespace: "smart_home"
    eventTopic: "events"
    logsTopic: "logs"
end

Broker<MQTT> home_mqtt_broker
    host: "mqtt.smarthome.local"
    port: 8883
    ssl: true
    auth:
        username: "casa_nova"
        password: "TooSmart4U@home"
end

Broker<Redis> monitor_redis_broker
    host: "redis.monitor.local"
    port: 6380
    ssl: true
    db: 2
    auth:
        key: "redis-4a9f1e7b3c2d6f8912a3b4c5d678e9f0"
end

Entity living_room_lamp
    type: actuator
    topic: "living_room.lamp"
    broker: home_mqtt_broker
    attributes:
        - power: bool
        - brightness: int
end

Entity living_room_sensor
    type: sensor
    topic: "living_room.sensor"
    broker: home_mqtt_broker
    freq: 30
    attributes:
        - temperature: float = 22.0 -> sinus(22, 2, 0.1) with noise gaussian(0, 0.5)
        - humidity: float = 55.0 -> sinus(55, 5, 0.1) with noise uniform(-2, 2)
end

Entity living_room_air_purifier
    type: actuator
    topic: "living_room.air_purifier"
    broker: home_mqtt_broker
    attributes:
        - power: bool
        - mode: str
end

Entity bedroom_temperature_sensor
    type: sensor
    topic: "bedroom.temperature_sensor"
    broker: home_mqtt_broker
    attributes:
        - temperature: float = 21.0 -> sinus(21, 2, 0.05) with noise gaussian(0, 0.3)
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: home_mqtt_broker
    attributes:
        - power: bool
end

Entity bedroom_air_conditioner
    type: actuator
    topic: "bedroom.air_conditioner"
    broker: home_mqtt_broker
    attributes:
        - power: bool
        - temperature: float
        - mode: str
end

Automation living_room_air_purifier_on
    condition:
        ((living_room_sensor.temperature > 25.0) AND 
        (living_room_sensor.humidity > 60.0)) AND 
        (living_room_lamp.power is false)
    enabled: true
    continuous: false
    actions:
        - living_room_air_purifier.power: true
        - living_room_air_purifier.mode: "auto"
    starts:
        - living_room_air_purifier_off
end

Automation living_room_air_purifier_off
    condition:
        (living_room_sensor.temperature < 24.0) AND 
        (living_room_sensor.humidity < 50.0)
    enabled: true
    continuous: false
    actions:
        - living_room_air_purifier.power: false
    starts:
        - living_room_air_purifier_on
end

Automation bedroom_ac_control
    condition:
        (mean(bedroom_temperature_sensor.temperature, 10) > 26.0) AND 
        (std(bedroom_temperature_sensor.temperature, 10) > 1.0)
    enabled: true
    continuous: false
    actions:
        - bedroom_air_conditioner.power: true
        - bedroom_air_conditioner.mode: "cool"
        - bedroom_air_conditioner.temperature: 23.0
end