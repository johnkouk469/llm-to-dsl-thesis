Metadata
    name: smart_home_env_control
    version: "1.4"
    description: "Automates environmental controls for optimal comfort in living and bedroom spaces, leveraging sensor data and efficient device management."
    author: "Lucas Navarro"
    email: "nova@homehub.tech"
end

RTMonitor
    broker: monitor_broker
    namespace: "casa.nova.universe"
    eventTopic: "epic_events"
    logsTopic: "chaotic_logs"
end

Broker<MQTT> home_mqtt_broker
    host: "mqtt.smarthome.local"
    port: 8883
    ssl: true
    auth:
        username: "casa_nova"
        password: "TooSmart4U@home"
end

Broker<Redis> monitor_broker
    host: "redis.monitor.local"
    port: 6380
    db: 2
    ssl: true
    auth:
        key: "redis-4a9f1e7b3c2d6f8912a3b4c5d678e9f0"
end

Entity living_room_temp_humidity_sensor
    type: sensor
    topic: "living_room.sensor"
    freq: 30
    broker: home_mqtt_broker
    attributes:
        - temperature: float -> gaussian(22, 35, 1) with noise gaussian(0, 1)
        - humidity: float -> gaussian(45, 70, 2) with noise uniform(0, 1)
end

Entity living_room_lamp
    type: actuator
    topic: "living_room.lamp"
    broker: home_mqtt_broker
    attributes:
        - power: bool
        - brightness: float
end

Entity air_purifier
    type: actuator
    topic: "living_room.purifier"
    broker: home_mqtt_broker
    attributes:
        - power: bool
        - mode: str
end

Entity bedroom_temp_sensor
    type: sensor
    topic: "bedroom.sensor"
    freq: 60
    broker: home_mqtt_broker
    attributes:
        - temperature: float -> gaussian(20, 30, 1) with noise gaussian(0, 1)
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: home_mqtt_broker
    attributes:
        - power: bool
end

Entity air_conditioner
    type: actuator
    topic: "bedroom.ac"
    broker: home_mqtt_broker
    attributes:
        - power: bool
        - temperature: float
        - mode: str
end

Automation living_room_purifier_activation
    condition:
        (
            (living_room_temp_humidity_sensor.temperature > 25) AND 
            (living_room_temp_humidity_sensor.humidity > 60) AND 
            (living_room_lamp.power is false)
        )
    enabled: true
    continuous: false
    freq: 90
    actions:
        - air_purifier.power: true
        - air_purifier.mode: "auto"
    starts:
        - living_room_purifier_deactivation
end

Automation living_room_purifier_deactivation
    condition:
        (
            (living_room_temp_humidity_sensor.temperature < 24) AND 
            (living_room_temp_humidity_sensor.humidity < 50)
        )
    enabled: false
    continuous: false
    freq: 120
    actions:
        - air_purifier.power: false
    starts:
        - living_room_purifier_activation
end

Automation bedroom_lamp_on_cold
    condition:
        bedroom_temp_sensor.temperature < 18
    enabled: true
    continuous: false
    checkOnce: true
    actions:
        - bedroom_lamp.power: true
end

Automation bedroom_ac_cool
    condition:
        (
            (mean(bedroom_temp_sensor.temperature, 10) > 26) AND 
            (std(bedroom_temp_sensor.temperature, 10) > 1)
        )
    enabled: true
    continuous: false
    freq: 180
    actions:
        - air_conditioner.power: true
        - air_conditioner.mode: "cool"
        - air_conditioner.temperature: 23
end

Automation living_room_lamp_night
    condition:
        system_clock.time == 22:00
    enabled: true
    continuous: false
    freq: 60
    actions:
        - living_room_lamp.power: true
        - living_room_lamp.brightness: 30.0
end