Metadata
    name: smart_home_env_control
    version: "1.4"
    description: "A model to automate environmental controls in a smart home, managing temperature, humidity, and lighting based on conditions using MQTT and Redis brokers."
    author: "Lucas Navarro"
    email: "nova@homehub.tech"
end

RTMonitor
    broker: redis_monitor
    namespace: "casa.nova.universe"
    eventTopic: "epic_events"
    logsTopic: "chaotic_logs"
end

Broker<MQTT> mqtt_broker
    host: "mqtt.smarthome.local"
    port: 8883
    ssl: true
    auth:
        username: "casa_nova"
        password: "TooSmart4U@home"
end

Broker<Redis> redis_monitor
    host: "redis.monitor.local"
    port: 6380
    db: 2
    ssl: true
    auth:
        key: "redis-4a9f1e7b3c2d6f8912a3b4c5d678e9f0"
end

Entity living_room_sensor
    type: sensor
    topic: "living_room.sensor"
    freq: 30
    broker: mqtt_broker
    attributes:
        - temperature: float -> gaussian(22, 35, 1) with noise gaussian(0, 1)
        - humidity: float -> gaussian(45, 70, 2) with noise uniform(0, 1)
end

Entity living_room_lamp
    type: actuator
    topic: "living_room.lamp"
    broker: mqtt_broker
    attributes:
        - power: bool
        - brightness: float
end

Entity air_purifier
    type: actuator
    topic: "living_room.air_purifier"
    broker: mqtt_broker
    attributes:
        - power: bool
        - mode: str
end

Entity bedroom_sensor
    type: sensor
    topic: "bedroom.sensor"
    freq: 60
    broker: mqtt_broker
    attributes:
        - temperature: float -> gaussian(20, 30, 1) with noise gaussian(0, 1)
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: mqtt_broker
    attributes:
        - power: bool
end

Entity air_conditioner
    type: actuator
    topic: "bedroom.air_conditioner"
    broker: mqtt_broker
    attributes:
        - power: bool
        - temperature: float
        - mode: str
end

Automation activate_air_purifier
    condition:
        (
            (living_room_sensor.temperature > 25) AND 
            (living_room_sensor.humidity > 60) AND 
            (living_room_lamp.power is false)
        )
    enabled: true
    continuous: false
    freq: 90
    actions:
        - air_purifier.power: true
        - air_purifier.mode: "auto"
    starts:
        - deactivate_air_purifier
end

Automation deactivate_air_purifier
    condition:
        (
            (living_room_sensor.temperature < 24) AND 
            (living_room_sensor.humidity < 50)
        )
    enabled: false
    continuous: false
    freq: 120
    actions:
        - air_purifier.power: false
    starts:
        - activate_air_purifier
end

Automation bedroom_lamp_auto_on
    condition:
        bedroom_sensor.temperature < 18
    enabled: true
    continuous: false
    checkOnce: true
    actions:
        - bedroom_lamp.power: true
end

Automation bedroom_ac_auto_cool
    condition:
        (mean(bedroom_sensor.temperature, 10) > 26) AND (std(bedroom_sensor.temperature, 10) > 1)
    enabled: true
    continuous: false
    freq: 180
    actions:
        - air_conditioner.power: true
        - air_conditioner.temperature: 23
        - air_conditioner.mode: "cool"
end

Automation living_room_lamp_night_on
    condition:
        system_clock.time == 22:00
    enabled: true
    continuous: true
    actions:
        - living_room_lamp.power: true
        - living_room_lamp.brightness: 30.0
end