Metadata
    name: smart_home_env_control
    version: "1.4"
    description: "A comprehensive automation system for smart home environmental control, optimizing living conditions through dynamic interactions between sensors and actuators."
    author: "Lucas Navarro"
    email: "nova@homehub.tech"
end

Broker<MQTT> smart_home_broker
    host: "mqtt.smarthome.local"
    port: 8883
    ssl: true
    auth:
        username: "casa_nova"
        password: "TooSmart4U@home"
end

Broker<Redis> monitor_broker
    host: "redis.monitor.local"
    port: 6380
    db: 2
    ssl: true
    auth:
        key: "redis-4a9f1e7b3c2d6f8912a3b4c5d678e9f0"
end

RTMonitor
    broker: monitor_broker
    namespace: "casa.nova.universe"
    eventTopic: "epic_events"
    logsTopic: "chaotic_logs"
end

Entity living_room_sensor
    type: sensor
    topic: "livingroom.sensor"
    freq: 30
    broker: smart_home_broker
    attributes:
        - temperature: float -> gaussian(22, 35, 1) with noise gaussian(0, 1)
        - humidity: float -> gaussian(45, 70, 2) with noise uniform(0, 1)
end

Entity living_room_lamp
    type: actuator
    topic: "livingroom.lamp"
    broker: smart_home_broker
    attributes:
        - power: bool
        - brightness: float
end

Entity living_room_purifier
    type: actuator
    topic: "livingroom.purifier"
    broker: smart_home_broker
    attributes:
        - power: bool
        - mode: str
end

Entity bedroom_sensor
    type: sensor
    topic: "bedroom.sensor"
    freq: 60
    broker: smart_home_broker
    attributes:
        - temperature: float -> gaussian(20, 30, 1) with noise gaussian(0, 1)
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: smart_home_broker
    attributes:
        - power: bool
end

Entity bedroom_air_conditioner
    type: actuator
    topic: "bedroom.ac"
    broker: smart_home_broker
    attributes:
        - power: bool
        - temperature: float
        - mode: str
end

Automation activate_purifier
    condition:
        (((living_room_sensor.temperature > 25) AND (living_room_sensor.humidity > 60)) AND (living_room_lamp.power is false))
    enabled: true
    continuous: false
    freq: 90
    actions:
        - living_room_purifier.power: true
        - living_room_purifier.mode: "auto"
    starts:
        - deactivate_purifier
end

Automation deactivate_purifier
    condition:
        ((living_room_sensor.temperature < 24) AND (living_room_sensor.humidity < 50))
    enabled: false
    continuous: false
    freq: 120
    actions:
        - living_room_purifier.power: false
    starts:
        - activate_purifier
end

Automation bedroom_lamp_on_cold
    condition:
        (bedroom_sensor.temperature < 18)
    enabled: true
    continuous: false
    checkOnce: true
    actions:
        - bedroom_lamp.power: true
end

Automation bedroom_ac_on_hot
    condition:
        ((mean(bedroom_sensor.temperature, 30) > 26) AND (std(bedroom_sensor.temperature, 30) > 1))
    enabled: true
    continuous: false
    freq: 180
    actions:
        - bedroom_air_conditioner.power: true
        - bedroom_air_conditioner.temperature: 23.0
        - bedroom_air_conditioner.mode: "cool"
end

Automation living_room_lamp_night
    condition:
        (system_clock.time == 22:00)
    enabled: true
    continuous: true
    actions:
        - living_room_lamp.power: true
        - living_room_lamp.brightness: 30.0
end