Metadata
    name: smart_home_env_control
    version: "1.4"
    description: "This model controls the environment in a smart home, managing temperature, humidity, and lighting based on specific conditions."
    author: "Lucas Navarro"
    email: "nova@homehub.tech"
end

RTMonitor
    broker: monitor_broker
    namespace: "casa.nova.universe"
    eventTopic: "epic_events"
    logsTopic: "chaotic_logs"
end

Broker<MQTT> home_broker
    host: "mqtt.smarthome.local"
    port: 8883
    ssl: true
    auth:
        username: "casa_nova"
        password: "TooSmart4U@home"
end

Broker<Redis> monitor_broker
    host: "redis.monitor.local"
    port: 6380
    db: 2
    ssl: true
    auth:
        key: "redis-4a9f1e7b3c2d6f8912a3b4c5d678e9f0"
end

Entity living_room_sensor
    type: sensor
    topic: "living_room.sensor"
    broker: home_broker
    freq: 30
    attributes:
        - temperature: float -> gaussian(22, 35, 1) with noise gaussian(0, 1)
        - humidity: float -> gaussian(45, 70, 2) with noise uniform(0, 1)
end

Entity living_room_lamp
    type: actuator
    topic: "living_room.lamp"
    broker: home_broker
    attributes:
        - power: bool
        - brightness: float
end

Entity living_room_purifier
    type: actuator
    topic: "living_room.purifier"
    broker: home_broker
    attributes:
        - power: bool
        - mode: str
end

Entity bedroom_sensor
    type: sensor
    topic: "bedroom.sensor"
    broker: home_broker
    freq: 60
    attributes:
        - temperature: float -> gaussian(20, 30, 1) with noise gaussian(0, 1)
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: home_broker
    attributes:
        - power: bool
end

Entity bedroom_ac
    type: actuator
    topic: "bedroom.ac"
    broker: home_broker
    attributes:
        - power: bool
        - temperature: float
        - mode: str
end

Automation activate_living_room_purifier
    condition:
        ((living_room_sensor.temperature > 25) AND 
        (living_room_sensor.humidity > 60)) AND
        (living_room_lamp.power is false)
    enabled: true
    continuous: false
    freq: 90
    actions:
        - living_room_purifier.power: true
        - living_room_purifier.mode: "auto"
    starts:
        - deactivate_living_room_purifier
end

Automation deactivate_living_room_purifier
    condition:
        (living_room_sensor.temperature < 24) AND
        (living_room_sensor.humidity < 50)
    enabled: false
    continuous: false
    freq: 120
    actions:
        - living_room_purifier.power: false
    starts:
        - activate_living_room_purifier
end

Automation turn_on_bedroom_lamp
    condition:
        bedroom_sensor.temperature < 18
    enabled: true
    continuous: false
    checkOnce: true
    actions:
        - bedroom_lamp.power: true
end

Automation adjust_bedroom_ac
    condition:
        (mean(bedroom_sensor.temperature, 180) > 26) AND
        (std(bedroom_sensor.temperature, 180) > 1)
    enabled: true
    continuous: false
    freq: 180
    actions:
        - bedroom_ac.power: true
        - bedroom_ac.temperature: 23
        - bedroom_ac.mode: "cool"
end

Automation living_room_lamp_night
    condition:
        system_clock.time == 22:00
    enabled: true
    continuous: false
    actions:
        - living_room_lamp.power: true
        - living_room_lamp.brightness: 30.0
end