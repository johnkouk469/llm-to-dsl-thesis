Metadata
    name: SmartHomeAutomation
    version: "1.0.0"
    description: "Automates living room and bedroom based on sensor data and time conditions."
    author: "Home Automation Specialist"
    email: "specialist@smarthome.com"
end

Broker<MQTT> mqtt_broker
    host: "mqtt.smarthome.local"
    port: 8883
    ssl: true
    auth:
        username: "casa_nova"
        password: "TooSmart4U@home"
end

Broker<Redis> monitoring_broker
    host: "redis.monitor.local"
    port: 6380
    db: 2
    ssl: true
    auth:
        key: "redis-4a9f1e7b3c2d6f8912a3b4c5d678e9f0"
end

Entity living_room_sensor
    type: sensor
    topic: "living_room.sensor"
    freq: 30
    broker: mqtt_broker
    attributes:
        - temperature: float
        - humidity: float
end

Entity living_room_lamp
    type: actuator
    topic: "living_room.lamp"
    broker: mqtt_broker
    attributes:
        - power: bool
        - brightness: int
end

Entity living_room_purifier
    type: actuator
    topic: "living_room.purifier"
    broker: mqtt_broker
    attributes:
        - power: bool
        - mode: str
end

Entity bedroom_sensor
    type: sensor
    topic: "bedroom.sensor"
    broker: mqtt_broker
    attributes:
        - temperature: float
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: mqtt_broker
    attributes:
        - power: bool
end

Entity bedroom_ac
    type: actuator
    topic: "bedroom.ac"
    broker: mqtt_broker
    attributes:
        - power: bool
        - temperature: float
        - mode: str
end

Automation living_room_purifier_on
    condition:
        ((living_room_sensor.temperature > 25) AND (living_room_sensor.humidity > 60)) AND (living_room_lamp.power is false)
    enabled: true
    continuous: false
    actions:
        - living_room_purifier.power: true
        - living_room_purifier.mode: "auto"
    starts:
        - living_room_purifier_off
end

Automation living_room_purifier_off
    condition:
        (living_room_sensor.temperature < 24) AND (living_room_sensor.humidity < 50)
    enabled: false
    continuous: false
    actions:
        - living_room_purifier.power: false
    starts:
        - living_room_purifier_on
end

Automation bedroom_ac_on
    condition:
        (mean(bedroom_sensor.temperature, 10) > 26) AND (std(bedroom_sensor.temperature, 10) > 1)
    enabled: true
    continuous: true
    actions:
        - bedroom_ac.power: true
        - bedroom_ac.temperature: 23.0
        - bedroom_ac.mode: "cool"
end

Automation bedroom_lamp_on
    condition:
        bedroom_sensor.temperature < 18
    enabled: true
    continuous: true
    actions:
        - bedroom_lamp.power: true
end

Automation living_room_lamp_night
    condition:
        system_clock.time == 22:00
    enabled: true
    continuous: false
    actions:
        - living_room_lamp.power: true
        - living_room_lamp.brightness: 30
end

RTMonitor
    broker: monitoring_broker
    namespace: "home_automation.monitoring"
    eventTopic: "events"
    logsTopic: "logs"
end