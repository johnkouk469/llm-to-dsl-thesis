Metadata
    name: SmartHomeAutomation
    version: "1.0.0"
    description: "Automation for living room and bedroom devices based on environmental conditions and time."
    author: "Smart Home Owner"
    email: "owner@smarthome.local"
end

RTMonitor
    broker: monitor_broker
    namespace: "smarthome.monitor"
    eventTopic: "events"
    logsTopic: "logs"
end

Broker<MQTT> living_broker
    host: "mqtt.smarthome.local"
    port: 8883
    ssl: true
    auth:
        username: "casa_nova"
        password: "TooSmart4U@home"
end

Broker<Redis> monitor_broker
    host: "redis.monitor.local"
    port: 6380
    db: 2
    ssl: true
    auth:
        key: "redis-4a9f1e7b3c2d6f8912a3b4c5d678e9f0"
end

Entity living_room_sensor
    type: sensor
    topic: "living_room.sensor"
    broker: living_broker
    freq: 30
    attributes:
        - temperature: float -> gaussian(22, 3, 1) with noise gaussian(0, 0.5)
        - humidity: float -> gaussian(50, 10, 3) with noise gaussian(0, 1)
end

Entity living_room_lamp
    type: actuator
    topic: "living_room.lamp"
    broker: living_broker
    attributes:
        - power: bool
        - brightness: int
end

Entity living_room_purifier
    type: actuator
    topic: "living_room.purifier"
    broker: living_broker
    attributes:
        - power: bool
        - mode: str
end

Entity bedroom_sensor
    type: sensor
    topic: "bedroom.sensor"
    broker: living_broker
    freq: 30
    attributes:
        - temperature: float -> gaussian(20, 3, 1) with noise gaussian(0, 0.5)
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: living_broker
    attributes:
        - power: bool
end

Entity bedroom_ac
    type: actuator
    topic: "bedroom.ac"
    broker: living_broker
    attributes:
        - power: bool
        - temperature: float
        - mode: str
end

Automation living_room_heat_humidity_control
    condition:
        ((living_room_sensor.temperature > 25) AND (living_room_sensor.humidity > 60)) AND (living_room_lamp.power is false)
    enabled: true
    continuous: false
    actions:
        - living_room_purifier.power: true
        - living_room_purifier.mode: "auto"
    starts:
        - living_room_normal_conditions
end

Automation living_room_normal_conditions
    condition:
        (living_room_sensor.temperature < 24) AND (living_room_sensor.humidity < 50)
    enabled: false
    continuous: false
    actions:
        - living_room_purifier.power: false
    starts:
        - living_room_heat_humidity_control
end

Automation bedroom_temperature_control
    condition:
        (mean(bedroom_sensor.temperature, 5) > 26) AND (std(bedroom_sensor.temperature, 5) > 0.5)
    enabled: true
    continuous: true
    actions:
        - bedroom_ac.power: true
        - bedroom_ac.mode: "cool"
        - bedroom_ac.temperature: 23.0
end

Automation bedroom_cold_temperature_light
    condition:
        bedroom_sensor.temperature < 18
    enabled: true
    continuous: true
    actions:
        - bedroom_lamp.power: true
end

Automation living_room_night_lighting
    condition:
        system_clock.time == 22:00
    enabled: true
    continuous: true
    actions:
        - living_room_lamp.power: true
        - living_room_lamp.brightness: 30
end